# Frontend - local Nhost defaults work with local/local.
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local
NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1

# Used by scripts/seed-demo.mjs only. Never expose this in NEXT_PUBLIC_*.
NHOST_ADMIN_SECRET=nhost-admin-secret
NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1
NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1

# Configure the same secret as a project environment variable in Nhost/Hasura.
ACTION_SECRET=change-me-to-a-long-random-secret

# Optional deterministic seed webhook secret. If omitted, seed-demo generates one.
DEMO_WEBHOOK_SECRET=

# Optional real LLM. If absent, llm_call uses the disclosed delayed stub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional. Set true only if you intentionally need RFC1918/localhost HTTP targets.
ALLOW_PRIVATE_HTTP=false
